<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.clockwiseknowledge</groupId>
    <artifactId>chapter-10-saml</artifactId>
    <version>1.0.0</version>

    <packaging>jar</packaging>

    <name>Chapter 10 - SAML Examples</name>
    <description>
        Companion Java examples for Chapter 10 - SAML
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>

        <plugins>

            <!-- Add the five example directories as source directories -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>

                <executions>
                    <execution>
                        <id>add-example-source-directories</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>

                        <configuration>
                            <sources>
                                <source>
                                    ${project.basedir}/create-saml-assertion
                                </source>
                                <source>
                                    ${project.basedir}/parse-saml-assertion
                                </source>
                                <source>
                                    ${project.basedir}/saml-base64-encoding
                                </source>
                                <source>
                                    ${project.basedir}/xml-digital-signature
                                </source>
                                <source>
                                    ${project.basedir}/saml-flow-simulation
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Java compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Run individual examples -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.1</version>

                <configuration>
                    <classpathScope>compile</classpathScope>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
