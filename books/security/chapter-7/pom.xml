<?xml version="1.0" encoding="UTF-8"?>

<!--
    Chapter 7 – Password Hashing and Salting

    This Maven configuration is the parent and aggregator POM
    for the Java examples in Chapter 7.

    The examples demonstrate password storage, salting, password
    verification, password-hashing algorithms, work factors, and
    password-hash migration.

    Each example is maintained as an independent Maven module,
    while this parent POM provides common build configuration
    and dependency versions.

    Java Version: 17
    Author: Sanjay Ghosh
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.clockwiseknowledge.security</groupId>
    <artifactId>chapter-7-password-hashing</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>Chapter 7 - Password Hashing and Salting</name>

    <description>
        Source code examples for Chapter 7 of Practical Application Security
    </description>

    <!--
        Chapter 7 Maven modules.

        Each directory contains an independent Java example.

        Author: Sanjay Ghosh
    -->
    <modules>
        <module>plaintext-demo</module>
        <module>unsalted-vs-salted</module>
        <module>password-verification</module>
        <module>password-algorithms</module>
        <module>work-factor</module>
        <module>password-migration</module>
    </modules>

    <properties>

        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-security.version>7.1.1</spring-security.version>
        <spring-framework.version>7.0.9</spring-framework.version>
        <commons-logging.version>1.3.5</commons-logging.version>
        <bouncycastle.version>1.86</bouncycastle.version>

        <maven.compiler-plugin.version>3.14.1</maven.compiler-plugin.version>

    </properties>

    <!--
        Common dependency versions are managed here.

        Individual modules declare only the dependencies
        that they actually use.

        Author: Sanjay Ghosh
    -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-crypto</artifactId>
                <version>${spring-security.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-core</artifactId>
                <version>${spring-framework.version}</version>
            </dependency>

            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>${commons-logging.version}</version>
            </dependency>

            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>

                <!--
                    Maven Compiler Plugin

                    Compiles all Chapter 7 examples using Java 17.

                    Author: Sanjay Ghosh
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
